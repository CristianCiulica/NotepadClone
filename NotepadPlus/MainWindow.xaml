<Window x:Class="NotepadPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NotepadPlus"
        mc:Ignorable="d"
        Title="Notepad++ Clone" Height="500" Width="900"
        FontFamily="Segoe UI" Background="#F3F3F3">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="5,3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="File">
                <MenuItem Header="New file" Command="{Binding NewFileCommand}"/>
                <MenuItem Header="Open file..." Command="{Binding OpenFileCommand}"/>
                <Separator/>
                <MenuItem Header="Save file" Command="{Binding SaveFileCommand}"/>
                <MenuItem Header="Save file as..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="Close all files" Command="{Binding CloseAllFilesCommand}"/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="Search">
                <MenuItem Header="Find..."/>
                <MenuItem Header="Replace..."/>
                <MenuItem Header="Replace All..."/>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Standard"/>
                <MenuItem Header="Folder Explorer"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Command="{Binding NewFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
                <Button Content="Open" Command="{Binding OpenFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
                <Button Content="Save" Command="{Binding SaveFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" x:Name="FolderExplorerColumn"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTreeView" Grid.Column="0" BorderThickness="0" Background="#F8F9FA">
            </TreeView>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#E0E0E0"/>

            <TabControl x:Name="FilesTabControl" Grid.Column="2" 
                        ItemsSource="{Binding Tabs}" 
                        SelectedItem="{Binding SelectedTab}"
                        BorderThickness="0" Background="#FFFFFF">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Button Content="✕" 
                                    Width="20" Height="20" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Foreground="#D32F2F"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" 
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 BorderThickness="0"
                                 Padding="10"
                                 Background="#FFFFFF"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>