<Window x:Class="NotepadPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notepad++ Clone" Height="550" Width="1000"
        FontFamily="Segoe UI" Background="#F3F3F3">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FFFFFF" Padding="5,3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <MenuItem Header="File">
                <MenuItem Header="New file" Command="{Binding NewFileCommand}"/>
                <MenuItem Header="Open file..." Command="{Binding OpenFileCommand}"/>
                <Separator/>
                <MenuItem Header="Save file" Command="{Binding SaveFileCommand}"/>
                <MenuItem Header="Save file as..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="Close all files" Command="{Binding CloseAllFilesCommand}"/>
                <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <MenuItem Header="Search">
                <MenuItem Header="Find..." Command="{Binding ShowSearchCommand}"/>
                <MenuItem Header="Replace..." Command="{Binding ShowSearchCommand}"/>
                <MenuItem Header="Replace All..." Command="{Binding ShowSearchCommand}"/>
            </MenuItem>

            <MenuItem Header="View">
                <MenuItem Header="Standard" Command="{Binding ViewStandardCommand}"/>
                <MenuItem Header="Folder Explorer" Command="{Binding ViewFolderExplorerCommand}"/>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Command="{Binding NewFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
                <Button Content="Open" Command="{Binding OpenFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
                <Button Content="Save" Command="{Binding SaveFileCommand}" Width="60" Height="25" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="#CCCCCC" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" x:Name="FolderExplorerColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTreeView" Grid.Column="0" Width="200" 
                      Visibility="{Binding IsFolderExplorerVisible, Converter={StaticResource BoolToVisConverter}}"
                      BorderThickness="0" Background="#F8F9FA" ItemsSource="{Binding DrivesAndFolders}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New file" Command="{Binding ContextNewFileCommand}"/>
                                    <MenuItem Header="Copy path" Command="{Binding ContextCopyPathCommand}"/>
                                    <MenuItem Header="Copy folder" Command="{Binding ContextCopyFolderCommand}"/>
                                    <MenuItem Header="Paste folder" Command="{Binding ContextPasteFolderCommand}"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenFileFromTreeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="2"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#E0E0E0"
                          Visibility="{Binding IsFolderExplorerVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <TabControl x:Name="FilesTabControl" Grid.Column="2" 
                        ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        BorderThickness="0" Background="#FFFFFF">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Button Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontWeight="Bold" Cursor="Hand"
                                    CommandParameter="{Binding}" Command="{Binding DataContext.CloseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" 
                                 AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="14" BorderThickness="0" Padding="10" Background="#FFFFFF"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>